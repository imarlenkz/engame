# EnGame production configuration. Copy to .env next to docker-compose.yml and fill in.
# Never commit the real .env. Generate secrets with:  openssl rand -base64 48

# Public address of the site
APP_ORIGIN=https://engame.imarlen.kz
TIMEZONE=Asia/Almaty

# Long random string (min 32 chars): signs sessions, CSRF and lesson run tokens
APP_SECRET=

# PostgreSQL (the compose file builds DATABASE_URL from these)
POSTGRES_USER=engame
POSTGRES_PASSWORD=
POSTGRES_DB=engame

# Allow sign-up with email + password (true/false). iMARLEN ID works independently of this.
AUTH_LOCAL_REGISTRATION=true

# iMARLEN ID (OpenID Connect). Register client "engame" at id.imarlen.kz with redirect URI
#   https://engame.imarlen.kz/api/v1/auth/idp/callback
# Leave all three empty to hide the "Sign in with iMARLEN ID" button.
OIDC_ISSUER=https://id.imarlen.kz
OIDC_CLIENT_ID=engame
OIDC_CLIENT_SECRET=

# Media storage: local (docker volume) or s3 (any S3-compatible storage)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Pronunciation check. "none" turns the feature off (the app says so to users).
# "whisper" = any OpenAI-compatible /audio/transcriptions endpoint. Audio is never stored.
SPEECH_PROVIDER=none
SPEECH_API_URL=
SPEECH_API_KEY=
SPEECH_MODEL=whisper-1

# Prometheus metrics at /api/v1/metrics need "Authorization: Bearer <token>". Empty = endpoint disabled.
METRICS_TOKEN=
# Show Swagger UI at /api/v1/docs in production
SWAGGER_PUBLIC=false
LOG_LEVEL=info

# Port on 127.0.0.1 that the host nginx proxies to
GATEWAY_PORT=4300
